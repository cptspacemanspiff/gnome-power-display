[Desktop Entry]
Name=Power Monitor
Comment=Live power draw, battery, and brightness from the power-monitor daemon
Type=Application
Icon=io.github.cptspacemanspiff.PowerMonitor.Cosmic
Exec=power-monitor-cosmic
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;power;battery;watts;
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
X-OverflowPriority=10
