name := 'power-monitor-cosmic'
appid := 'io.github.cptspacemanspiff.PowerMonitor.Cosmic'

# Dev build recipes only. The supported install path is the system package:
# from the repo root run `scripts/install-packages.sh install`.

default: build-release

build-debug:
    cargo build

build-release:
    cargo build --release

clean:
    cargo clean
